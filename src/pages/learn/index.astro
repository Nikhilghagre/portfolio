---
import LearnLayout from '../../layouts/LearnLayout.astro';
import { tracks } from '../../data/learn';
import { profile } from '../../data/profile';
import { url } from '../../lib/url';
---

<LearnLayout
  title="Learning Hub"
  description="Free, hands-on teaching material on SOLID, DSA interview patterns, JavaScript and design patterns — by Nikhil Ghagre."
>
  <div class="wrap">
    <section class="hero">
      <p class="prompt mono" data-reveal>
        <span class="accent">guest@learn</span><span class="muted">:</span><span class="cyan">~</span><span class="muted">$</span> ls tracks/
      </p>
      <h1 class="title" data-reveal style="--d:1">
        Learning <span class="accent">Hub</span>
      </h1>
      <p class="lead" data-reveal style="--d:2">
        The notes and code I use to learn backend engineering — written so you can learn from them too. Everything is hands-on, opinionated
        and runnable. No fluff, no paywall.
      </p>
    </section>

    <section class="tracks">
      {
        tracks.map((t, i) => {
          const live = t.status === 'live';
          const Tag = live ? 'a' : 'div';
          return (
            <Tag
              href={live ? url(`learn/${t.id}/`) : undefined}
              class:list={['track', { 'track--live': live }]}
              data-reveal
              data-glow
              style={`--d:${i % 2}`}
            >
              <div class="track__top mono">
                <span class="track__path">
                  ~/learn/<span class="accent">{t.id}</span>/
                </span>
                {live ? <span class="badge badge--live">● live</span> : <span class="badge">coming soon</span>}
              </div>
              <h2 class="track__title">{t.title}</h2>
              <p class="track__blurb">{t.blurb}</p>
              <div class="track__foot">
                <ul class="track__tags mono">
                  {t.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {live && (
                  <span class="track__cta mono">
                    {t.lessons} lessons <span class="track__arrow">→</span>
                  </span>
                )}
              </div>
              {live && (
                <div class="track__progress mono" data-progress={t.id} data-total={t.lessons}>
                  <span class="track__bar">
                    <span class="track__fill" />
                  </span>
                  <span>
                    <span data-progress-count>0</span>/{t.lessons}
                  </span>
                </div>
              )}
            </Tag>
          );
        })
      }
    </section>

    <section class="about" data-reveal>
      <div class="term">
        <div class="term__bar">
          <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
          <span class="term__title">why.md</span>
        </div>
        <div class="term__body about__body">
          <p>
            <span class="accent">#</span> I'm {profile.name}, a backend developer with 4.5+ years of shipping Node.js, TypeScript and PHP services.
          </p>
          <p>
            The fastest way I know to really understand something is to <strong>build it, break it, and explain it</strong>. These tracks are
            exactly that: the material I wrote while learning, cleaned up so others can use it.
          </p>
          <p class="muted">Found a mistake or have a question? <a href={`mailto:${profile.email}`}>Tell me</a> — I read everything.</p>
        </div>
      </div>
    </section>
  </div>
</LearnLayout>

<style>
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .hero {
    padding: 80px 0 48px;
    max-width: 720px;
  }
  .prompt {
    font-size: 13px;
    color: var(--text);
  }
  .cyan {
    color: var(--cyan);
  }
  .title {
    margin-top: 12px;
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--text-hi);
  }
  .lead {
    margin-top: 20px;
    font-size: 18px;
    color: var(--muted);
  }

  .tracks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .track {
    --gx: 50%;
    --gy: 50%;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color 0.35s,
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease),
      filter 0.8s var(--ease);
  }
  .track::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(380px circle at var(--gx) var(--gy), rgba(74, 222, 128, 0.1), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .track--live:hover::before {
    opacity: 1;
  }
  .track--live:hover {
    border-color: rgba(74, 222, 128, 0.45);
  }
  .track:not(.track--live) {
    border-style: dashed;
  }
  .track:not(.track--live) > * {
    opacity: 0.55;
  }
  .track--live {
    grid-column: span 2;
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(74, 222, 128, 0.08), transparent 70%),
      var(--surface);
  }
  .track__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
  }
  .badge {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--border-hi);
    color: var(--muted);
  }
  .badge--live {
    color: var(--green);
    border-color: rgba(74, 222, 128, 0.35);
    background: rgba(74, 222, 128, 0.08);
  }
  .track__title {
    margin-top: 18px;
    font-size: 22px;
    font-weight: 700;
    color: var(--text-hi);
    transition: color 0.3s;
  }
  .track--live .track__title {
    font-size: clamp(26px, 3vw, 34px);
    letter-spacing: -0.02em;
  }
  .track--live:hover .track__title {
    color: var(--green);
  }
  .track__blurb {
    margin-top: 8px;
    color: var(--muted);
    max-width: 640px;
  }
  .track__foot {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .track__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 12px;
    color: var(--dim);
  }
  .track__cta {
    font-size: 13px;
    color: var(--green);
  }
  .track__arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }
  .track--live:hover .track__arrow {
    transform: translateX(5px);
  }
  .track__progress {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  .track__bar {
    flex: 1;
    max-width: 260px;
    height: 4px;
    border-radius: 4px;
    background: var(--border);
    overflow: hidden;
  }
  .track__fill {
    display: block;
    height: 100%;
    width: var(--pct, 0%);
    background: linear-gradient(90deg, var(--green), var(--cyan));
    transition: width 0.8s var(--ease);
  }

  .about {
    margin-top: 72px;
    max-width: 760px;
  }
  .about__body {
    display: grid;
    gap: 12px;
    font-size: 15px;
    color: var(--text);
  }
  .about__body strong {
    color: var(--text-hi);
  }
  .about__body a {
    color: var(--green);
  }

  @media (max-width: 760px) {
    .wrap {
      padding: 0 16px;
    }
    .hero {
      padding-top: 48px;
    }
    .tracks {
      grid-template-columns: 1fr;
    }
    .track--live {
      grid-column: auto;
    }
  }
</style>
