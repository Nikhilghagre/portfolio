---
import LearnLayout from '../../../layouts/LearnLayout.astro';
import { solidSteps, solidUpcoming, sourceRepo } from '../../../data/learn';
import { totalFiles, totalLines } from '../../../lib/code';
import { url } from '../../../lib/url';

const principles = solidSteps.filter((s) => s.letter.length === 1 && /[A-Z]/.test(s.letter));
const stats = [
  { value: solidSteps.length, label: 'lessons' },
  { value: totalFiles, label: 'code files' },
  { value: totalLines, label: 'lines of code' },
  { value: 0, label: 'dependencies' },
];
const how = [
  { cmd: 'cat NOTES.md', title: 'Read the lesson', text: 'Short, opinionated notes: the rule, the smell, the fix — and the myths to avoid.' },
  { cmd: 'ls ./', title: 'Explore the code', text: 'Every file of the step in an in-page explorer. File names in the notes open the code.' },
  { cmd: 'node run.js', title: 'Run it yourself', text: 'Plain Node.js, zero dependencies. Clone, run, break it, fix it.' },
];
---

<LearnLayout
  title="SOLID in Node.js"
  description="Learn SOLID by refactoring one real Node.js Order Checkout System from a god class into clean, testable code."
  crumbs={[{ label: 'solid' }]}
>
  <div class="wrap">
    <section class="hero">
      <div class="hero__text">
        <p class="eyebrow mono" data-reveal>course · {solidSteps.length} lessons · node.js</p>
        <h1 class="title" data-reveal style="--d:1">SOLID in <span class="accent">Node.js</span></h1>
        <p class="lead" data-reveal style="--d:2">
          We build <strong>one real app</strong> — an Order Checkout System — and refactor it step by step, from a 150-line god class into
          clean, testable code. One principle per lesson, every change runnable.
        </p>
        <div class="actions" data-reveal style="--d:3">
          <a class="btn" href={url(`learn/solid/${solidSteps[0].id}/`)} data-resume="solid" data-resume-base={url('learn/solid/')}>
            <span data-resume-label>start course</span> →
          </a>
          <a class="btn btn--ghost" href={sourceRepo} target="_blank" rel="noopener">view source ↗</a>
        </div>
        <div class="progress mono" data-reveal style="--d:4" data-progress="solid" data-total={solidSteps.length}>
          <span class="progress__bar"><span class="progress__fill"></span></span>
          <span><span data-progress-count>0</span>/{solidSteps.length} complete</span>
        </div>
      </div>

      <div class="letters" aria-label="S O L I D">
        {
          principles.map((s, i) => (
            <a href={url(`learn/solid/${s.id}/`)} class="letter" style={`--i:${i}`} data-step={s.id}>
              <span class="letter__char mono">{s.letter}</span>
              <span class="letter__name">{s.name}</span>
              <span class="letter__check">✓</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="stats" data-reveal>
      {
        stats.map((s) => (
          <div class="stat">
            <span class="stat__value mono" data-count={s.value}>
              {s.value}
            </span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))
      }
    </section>

    <blockquote class="motto" data-reveal>
      <p class="motto__label mono">// the one-line definition of good design</p>
      <p class="motto__text">
        Things that <span class="accent">change together</span> live together. Things that change for <span class="amber">different reasons</span> live
        apart.
      </p>
      <p class="motto__sub">Everything in this course is that sentence, applied five ways.</p>
    </blockquote>

    <section class="section">
      <h2 class="h2" data-reveal><span class="mono accent">$</span> ls lessons/</h2>
      <ol class="road">
        {
          solidSteps.map((s, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              <a href={url(`learn/solid/${s.id}/`)} class="road__item" data-step={s.id}>
                <span class="road__no mono">{String(i).padStart(2, '0')}</span>
                <span class="road__letter mono">{s.letter}</span>
                <span class="road__body">
                  <span class="road__name">
                    {s.name} <span class="road__short mono">{s.short}</span>
                  </span>
                  <span class="road__summary">{s.summary}</span>
                </span>
                <span class="road__status mono">
                  <span class="road__done">✓ done</span>
                  <span class="road__go">open →</span>
                </span>
              </a>
            </li>
          ))
        }
        {
          solidUpcoming.map((s) => (
            <li data-reveal>
              <span class="road__item is-soon">
                <span class="road__no mono">··</span>
                <span class="road__letter mono">{s.letter}</span>
                <span class="road__body">
                  <span class="road__name">{s.name}</span>
                  <span class="road__summary">{s.summary}</span>
                </span>
                <span class="road__status mono">coming soon</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section">
      <h2 class="h2" data-reveal><span class="mono accent">$</span> how each lesson works</h2>
      <div class="how">
        {
          how.map((h, i) => (
            <div class="how__card" data-reveal style={`--d:${i}`}>
              <p class="how__cmd mono">
                <span class="accent">$</span> {h.cmd}
              </p>
              <h3 class="how__title">{h.title}</h3>
              <p class="how__text">{h.text}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</LearnLayout>

<style>
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
    padding: 72px 0 48px;
  }
  .eyebrow {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--green);
  }
  .title {
    margin-top: 10px;
    font-size: clamp(40px, 5.5vw, 64px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-hi);
  }
  .lead {
    margin-top: 18px;
    font-size: 18px;
    color: var(--muted);
    max-width: 520px;
  }
  .lead strong {
    color: var(--text-hi);
  }
  .actions {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .progress {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
    max-width: 360px;
  }
  .progress__bar {
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: var(--border);
    overflow: hidden;
  }
  .progress__fill {
    display: block;
    height: 100%;
    width: var(--pct, 0%);
    background: linear-gradient(90deg, var(--green), var(--cyan));
    transition: width 0.8s var(--ease);
  }

  /* S O L I D tiles */
  .letters {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }
  .letter {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    aspect-ratio: 0.62;
    padding: 14px 6px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, var(--surface), var(--bg-2));
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
    animation:
      tile-in 0.8s var(--ease) forwards,
      tile-glow 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.1s + 0.2s), calc(var(--i) * 1.2s + 1.2s);
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .letter:nth-child(even) {
    margin-top: 36px;
  }
  @keyframes tile-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes tile-glow {
    0%,
    12%,
    100% {
      box-shadow: none;
      border-color: var(--border);
    }
    5% {
      box-shadow: 0 0 40px -6px rgba(74, 222, 128, 0.5);
      border-color: rgba(74, 222, 128, 0.6);
    }
  }
  .letter:hover {
    border-color: var(--green);
    transform: translateY(-6px);
  }
  .letter__char {
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1;
    color: var(--text-hi);
    margin-bottom: auto;
    margin-top: 18%;
    transition:
      color 0.3s,
      text-shadow 0.3s;
  }
  .letter:hover .letter__char {
    color: var(--green);
    text-shadow: 0 0 24px rgba(74, 222, 128, 0.7);
  }
  .letter__name {
    font-size: 11px;
    line-height: 1.3;
    color: var(--muted);
  }
  .letter__check {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    font-size: 10px;
    color: var(--bg);
    background: var(--green);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease);
  }
  .letter:global(.is-done) .letter__char {
    color: var(--green);
  }
  .letter:global(.is-done) .letter__check {
    opacity: 1;
    transform: none;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(14, 19, 24, 0.6);
  }
  .stat {
    padding: 20px;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
  }
  .stat:last-child {
    border-right: 0;
  }
  .stat__value {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-hi);
  }
  .stat__label {
    font-size: 13px;
    color: var(--muted);
  }

  .motto {
    margin: 72px auto 0;
    max-width: 820px;
    text-align: center;
  }
  .motto__label {
    font-size: 12px;
    color: var(--dim);
  }
  .motto__text {
    margin-top: 12px;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.35;
    font-weight: 600;
    color: var(--text-hi);
    letter-spacing: -0.01em;
  }
  .amber {
    color: var(--amber);
  }
  .motto__sub {
    margin-top: 12px;
    color: var(--muted);
  }

  .section {
    margin-top: 88px;
  }
  .h2 {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-hi);
    margin-bottom: 20px;
  }

  .road {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .road__item {
    display: grid;
    grid-template-columns: 28px 48px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease),
      background 0.3s;
  }
  a.road__item:hover {
    border-color: rgba(74, 222, 128, 0.4);
    transform: translateX(6px);
  }
  .road__no {
    font-size: 12px;
    color: var(--dim);
  }
  .road__letter {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    font-size: 22px;
    font-weight: 700;
    color: var(--green);
    border: 1px solid rgba(74, 222, 128, 0.3);
    background: rgba(74, 222, 128, 0.06);
  }
  .road__name {
    display: block;
    font-size: 17px;
    font-weight: 600;
    color: var(--text-hi);
  }
  .road__short {
    font-size: 11px;
    font-weight: 400;
    color: var(--dim);
    margin-left: 6px;
  }
  .road__summary {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    color: var(--muted);
  }
  .road__status {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .road__done {
    display: none;
    color: var(--green);
  }
  a.road__item:hover .road__go {
    color: var(--green);
  }
  .road__item:global(.is-done) .road__done {
    display: inline;
  }
  .road__item:global(.is-done) .road__go {
    display: none;
  }
  .road__item:global(.is-done) .road__letter {
    background: var(--green);
    color: var(--bg);
  }
  .road__item.is-soon {
    opacity: 0.5;
    border-style: dashed;
  }
  .is-soon .road__letter {
    color: var(--muted);
    border-color: var(--border-hi);
    background: transparent;
  }

  .how {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .how__card {
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: rgba(14, 19, 24, 0.6);
  }
  .how__cmd {
    font-size: 12px;
    color: var(--muted);
  }
  .how__title {
    margin-top: 12px;
    font-size: 17px;
    font-weight: 600;
    color: var(--text-hi);
  }
  .how__text {
    margin-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .wrap {
      padding: 0 16px;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 48px;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(2) {
      border-right: 0;
    }
    .stat:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
    .how {
      grid-template-columns: 1fr;
    }
    .road__item {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 14px;
      padding: 16px;
    }
    .road__no,
    .road__status {
      display: none;
    }
    .road__letter {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }
  }
  @media (max-width: 480px) {
    .letters {
      gap: 6px;
    }
    .letter {
      border-radius: 10px;
    }
    .letter__name {
      font-size: 9px;
    }
  }
</style>
