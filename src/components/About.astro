---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section id="about" class="section">
  <SectionHeading index="01" title="About me" command="cat about.md" />

  <div class="about">
    {
      profile.about.map((p, i) => (
        <p data-reveal style={`--d:${i + 1}`}>
          {p}
        </p>
      ))
    }
  </div>

  <div class="stats">
    {
      profile.stats.map((s, i) => (
        <div class="stat" data-reveal style={`--d:${i + 1}`}>
          <span class="stat__value mono">
            <span data-count={s.value}>0</span>
            <span class="accent">{s.suffix}</span>
          </span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 18px;
    color: var(--muted);
    font-size: 17px;
  }
  .stats {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(14, 19, 24, 0.6);
    overflow: hidden;
  }
  .stat {
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-right: 1px solid var(--border);
    transition: background 0.3s;
  }
  .stat:last-child {
    border-right: 0;
  }
  .stat:hover {
    background: var(--surface-2);
  }
  .stat__value {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-hi);
    line-height: 1.1;
  }
  .stat__label {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(2) {
      border-right: 0;
    }
    .stat:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
  }
</style>
