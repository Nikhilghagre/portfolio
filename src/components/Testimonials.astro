---
import { testimonials } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const initials = (n: string) =>
  n
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);

const count = testimonials.length;
const average = count ? testimonials.reduce((s, t) => s + t.rating, 0) / count : 0;
// 3+ reviews scroll as a marquee; fewer sit in a simple grid
const useMarquee = count >= 3;
const rows = [testimonials, [...testimonials].reverse()];
---

{count > 0 && (
<section id="testimonials" class="section">
  <SectionHeading index="05" title="What people say" command="tail -f reviews.log" />

  <div class="summary" data-reveal>
    <p class="summary__score">
      <span class="summary__avg mono">{average.toFixed(1)}</span>
      <span class="summary__stars" aria-label={`${average.toFixed(1)} out of 5 stars`}>{stars(Math.round(average))}</span>
      <span class="summary__count mono">
        {count} {count === 1 ? 'review' : 'reviews'}
      </span>
    </p>
  </div>

  {
    count > 0 &&
      (useMarquee ? (
        <div class="marquee" data-reveal>
          {rows.map((row, r) => (
            <div class:list={['marquee__row', { 'marquee__row--rev': r === 1 }]}>
              <div class="marquee__track">
                {[...row, ...row].map((t, i) => (
                  <figure class="quote" aria-hidden={i >= row.length ? 'true' : undefined}>
                    <span class="quote__stars" aria-label={`${t.rating} out of 5 stars`}>{stars(t.rating)}</span>
                    <blockquote>{t.quote}</blockquote>
                    <figcaption>
                      <span class="quote__avatar mono">{initials(t.name)}</span>
                      <span>
                        <span class="quote__name">{t.name}</span>
                        {t.title && <span class="quote__title">{t.title}</span>}
                      </span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="grid">
          {testimonials.map((t, i) => (
            <figure class="quote" data-reveal style={`--d:${i}`}>
              <span class="quote__stars" aria-label={`${t.rating} out of 5 stars`}>{stars(t.rating)}</span>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="quote__avatar mono">{initials(t.name)}</span>
                <span>
                  <span class="quote__name">{t.name}</span>
                  {t.title && <span class="quote__title">{t.title}</span>}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      ))
  }

</section>
)}

<style>
  .summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .summary__score {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .summary__avg {
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    color: var(--text-hi);
  }
  .summary__stars {
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--amber);
    text-shadow: 0 0 14px rgba(251, 191, 36, 0.4);
  }
  .summary__count {
    font-size: 13px;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .marquee {
    display: grid;
    gap: 16px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__row {
    overflow: hidden;
  }
  .marquee__track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: scroll 50s linear infinite;
  }
  .marquee__row--rev .marquee__track {
    animation-direction: reverse;
    animation-duration: 60s;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  @keyframes scroll {
    to {
      transform: translateX(calc(-50% - 8px));
    }
  }
  .marquee .quote {
    width: 340px;
    flex-shrink: 0;
  }
  .quote {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .quote:hover {
    border-color: rgba(74, 222, 128, 0.35);
    transform: translateY(-3px);
  }
  .quote__stars {
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--amber);
  }
  blockquote {
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    flex: 1;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .quote__avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 700;
    color: var(--bg);
    background: linear-gradient(135deg, var(--green), var(--cyan));
    flex-shrink: 0;
  }
  .quote__name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-hi);
    line-height: 1.3;
  }
  .quote__title {
    display: block;
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .marquee .quote {
      width: 280px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__row {
      overflow-x: auto;
    }
  }
</style>
