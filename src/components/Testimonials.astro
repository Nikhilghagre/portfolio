---
import { testimonials } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const initials = (n: string) =>
  n
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2);
// duplicate the list so the marquee loops seamlessly
const rows = [testimonials, [...testimonials].reverse()];
---

{testimonials.length > 0 && (
<section id="testimonials" class="section">
  <SectionHeading index="05" title="What people say" command="tail -f reviews.log" />

  <div class="marquee" data-reveal>
    {
      rows.map((row, r) => (
        <div class:list={['marquee__row', { 'marquee__row--rev': r === 1 }]}>
          <div class="marquee__track">
            {[...row, ...row].map((t, i) => (
              <figure class="quote" aria-hidden={i >= row.length ? 'true' : undefined}>
                <span class="quote__icon">
                  <Icon name="quote" size={18} />
                </span>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <span class="quote__avatar mono">{initials(t.name)}</span>
                  <span>
                    <span class="quote__name">{t.name}</span>
                    <span class="quote__title">{t.title}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
)}

<style>
  .marquee {
    display: grid;
    gap: 16px;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__row {
    overflow: hidden;
  }
  .marquee__track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: scroll 50s linear infinite;
  }
  .marquee__row--rev .marquee__track {
    animation-direction: reverse;
    animation-duration: 60s;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  @keyframes scroll {
    to {
      transform: translateX(calc(-50% - 8px));
    }
  }
  .quote {
    width: 340px;
    flex-shrink: 0;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .quote:hover {
    border-color: rgba(74, 222, 128, 0.35);
    transform: translateY(-3px);
  }
  .quote__icon {
    color: var(--green);
    opacity: 0.7;
  }
  blockquote {
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    flex: 1;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .quote__avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 700;
    color: var(--bg);
    background: linear-gradient(135deg, var(--green), var(--cyan));
    flex-shrink: 0;
  }
  .quote__name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-hi);
    line-height: 1.3;
  }
  .quote__title {
    display: block;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .quote {
      width: 280px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__row {
      overflow-x: auto;
    }
  }
</style>
