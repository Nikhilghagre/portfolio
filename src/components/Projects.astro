---
import { projects, sideProjects } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section id="projects" class="section">
  <SectionHeading index="03" title="Selected projects" command="ls -la ~/projects" />

  <div class="grid">
    {
      projects.map((p, i) => (
        <article class:list={['card', { 'card--wide': p.featured }]} data-reveal data-glow data-tilt style={`--d:${i % 2}`}>
          <div class="card__head">
            <span class="card__folder">
              <Icon name="folder" size={26} />
            </span>
            <span class="card__links">
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener" aria-label={`${p.title} source on GitHub`}>
                  <Icon name="github" size={18} />
                </a>
              )}
              {p.live && (
                <a href={p.live} target="_blank" rel="noopener" aria-label={`${p.title} live demo`}>
                  <Icon name="external" size={18} />
                </a>
              )}
            </span>
          </div>

          <h3 class="card__title">{p.title}</h3>
          <p class="card__desc">{p.description}</p>

          <div class="card__foot">
            {p.metric && (
              <p class="card__metric mono">
                <span class="muted">// </span>
                {p.metric}
              </p>
            )}
            <ul class="card__stack mono">
              {p.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>

  {
    sideProjects.length > 0 && (
      <div class="side-proj">
        <p class="side-proj__cmd mono" data-reveal>
          <span class="accent">$</span> ls ~/side-projects
        </p>
        <ul class="side-proj__list">
          {sideProjects.map((sp, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              {sp.url ? (
                <a class="side-proj__row" href={sp.url} target="_blank" rel="noopener">
                  <span class="side-proj__title">{sp.title}</span>
                  <span class="side-proj__note mono">{sp.note}</span>
                  <Icon name="external" size={14} />
                </a>
              ) : (
                <span class="side-proj__row">
                  <span class="side-proj__title">{sp.title}</span>
                  <span class="side-proj__note mono">{sp.note}</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .card {
    --gx: 50%;
    --gy: 50%;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    isolation: isolate;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      border-color 0.35s,
      box-shadow 0.35s,
      transform 0.5s var(--ease),
      opacity 0.8s var(--ease),
      filter 0.8s var(--ease);
  }
  .card[data-reveal]:not(.is-in) {
    transform: translateY(28px);
  }
  .card[data-reveal].is-in {
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  }
  /* cursor-following glow */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(380px circle at var(--gx) var(--gy), rgba(74, 222, 128, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  /* glowing border */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(260px circle at var(--gx) var(--gy), var(--green), transparent 70%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .card:hover::before,
  .card:hover::after {
    opacity: 1;
  }
  .card:hover {
    box-shadow: 0 24px 60px -30px rgba(74, 222, 128, 0.25);
  }
  .card--wide {
    grid-column: span 2;
  }
  .card--wide .card__title {
    font-size: 22px;
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .card__folder {
    color: var(--green);
  }
  .card__links {
    display: flex;
    gap: 4px;
  }
  .card__links a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--muted);
    transition:
      color 0.25s,
      background 0.25s;
  }
  .card__links a:hover {
    color: var(--green);
    background: var(--surface-2);
  }
  .card__title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-hi);
    line-height: 1.35;
    transition: color 0.3s;
  }
  .card:hover .card__title {
    color: var(--green);
  }
  .card__desc {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }
  .card__foot {
    margin-top: auto;
    padding-top: 20px;
  }
  .card__metric {
    font-size: 13px;
    color: var(--amber);
    margin-bottom: 12px;
  }
  .card__stack {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 12px;
    color: var(--dim);
  }
  .card:hover .card__stack {
    color: var(--muted);
  }

  .side-proj {
    margin-top: 48px;
  }
  .side-proj__cmd {
    font-size: 12px;
    color: var(--dim);
    margin-bottom: 10px;
  }
  .side-proj__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .side-proj__row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 15px;
    transition:
      color 0.25s,
      padding 0.3s var(--ease),
      background 0.25s;
  }
  .side-proj__row::before {
    content: '▹';
    color: var(--green);
  }
  a.side-proj__row:hover {
    color: var(--green);
    padding-left: 12px;
    background: rgba(74, 222, 128, 0.04);
  }
  .side-proj__title {
    flex: 1;
    min-width: 0;
  }
  .side-proj__note {
    font-size: 11px;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card--wide {
      grid-column: auto;
    }
  }
</style>
