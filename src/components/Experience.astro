---
import { experience } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section id="experience" class="section">
  <SectionHeading index="02" title="Experience" command="git log --oneline --career" />

  <div class="tl-wrap" data-timeline>
  <span class="tl__track" aria-hidden="true"><span class="tl__fill"></span></span>
  <ol class="tl">
    {
      experience.map((job) => (
        <li class:list={['job', { 'job--current': job.current }]} data-reveal>
          <span class="job__dot" aria-hidden="true" />
          <div class="job__card">
            <p class="job__period mono">
              {job.period}
              {job.location && <span class="job__loc">· {job.location}</span>}
              {job.current && <span class="job__badge">current</span>}
            </p>
            <h3 class="job__title">
              {job.role}
              <span class="accent"> @ </span>
              {job.url ? (
                <a href={job.url} target="_blank" rel="noopener" class="job__company">
                  {job.company}
                  <Icon name="external" size={14} />
                </a>
              ) : (
                <span class="job__company">{job.company}</span>
              )}
            </h3>
            <ul class="job__points">
              {job.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <div class="job__stack">
              {job.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
  </div>
</section>

<style>
  .tl-wrap {
    position: relative;
  }
  .tl {
    list-style: none;
    padding: 0;
    position: relative;
    display: grid;
    gap: 18px;
  }
  .tl__track {
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .tl__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--green), var(--cyan));
    transform-origin: top;
    transform: scaleY(var(--p, 0));
    box-shadow: 0 0 10px var(--green);
  }
  .job {
    position: relative;
    padding-left: 40px;
  }
  .job__dot {
    position: absolute;
    left: 0;
    top: 26px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--border-hi);
    transition:
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .job.is-in .job__dot {
    border-color: var(--green);
  }
  .job--current .job__dot {
    background: var(--green);
    box-shadow: 0 0 0 5px var(--green-glow);
  }
  .job__card {
    padding: 20px 22px;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition:
      background 0.35s var(--ease),
      border-color 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  .job__card:hover {
    background: rgba(14, 19, 24, 0.75);
    border-color: var(--border);
    transform: translateX(4px);
  }
  .job__period {
    font-size: 12px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .job__loc {
    text-transform: none;
    letter-spacing: 0;
  }
  .job__badge {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--bg);
    background: var(--green);
    letter-spacing: 0.08em;
  }
  .job__title {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 600;
    color: var(--text-hi);
    line-height: 1.4;
  }
  .job__company {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--green);
  }
  .job__company :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .job__company:hover :global(svg) {
    transform: translate(2px, -2px);
  }
  .job__points {
    margin-top: 12px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    color: var(--muted);
    font-size: 15px;
  }
  .job__points li {
    position: relative;
    padding-left: 20px;
  }
  .job__points li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--green);
  }
  .job__stack {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 640px) {
    .job {
      padding-left: 28px;
    }
    .job__card {
      padding: 16px 4px 16px 8px;
    }
  }
</style>
